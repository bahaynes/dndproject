          "gold": 100,
          "xp": 600,
          "item_name": null,
          "is_hidden": false,
          "hint": "Joint Guildhall & Lantern Circle contract"
        }
      ]
    },
    {
      "name": "The Surveyed Vault",
      "description": "The Lantern Circle has pinpointed a dormant obsidian cairn in the western crags. Escort their surveyor or clear the antechamber so the obelisk readings can be recorded.",
      "status": "Available",
      "tier": "Tier 1",
      "region": "Obsidian Cairn",
