  "missions": [
    {
      "name": "The Quiet Convoy",
      "description": "A supply caravan out of Crossroads Keep went silent three days ago near Ashwood Crossing. The manifest is routine\u2014timber, lamp oil, and rations\u2014nothing worth a bandit raid, yet no rider has returned.",
      "status": "Available",
      "tier": "Tier 1",
      "region": "Ashwood Crossing",
      "cooldown_days": 14,
      "is_discoverable": true,
      "is_retired": false,
      "prerequisite_name": null,
      "rewards": [
        {
          "gold": 50,
          "xp": 300,
          "item_name": null,
          "is_hidden": false,
          "hint": "Guildhall standard recovery bounty"
        }
      ]
    },
    {
      "name": "Beacon on the Ridge",
      "description": "An old Warden watchtower on the northern ridge began flashing its signal lantern on loop last night. The Wardens abandoned that post three winters ago; someone\u2014or something\u2014has relit the brazier.",
      "status": "Available",
      "tier": "Tier 1",
      "region": "Northern Ridge",
      "cooldown_days": 14,
      "is_discoverable": true,
      "is_retired": false,
      "prerequisite_name": null,
      "rewards": [
        {
          "gold": 75,
          "xp": 450,
          "item_name": null,
          "is_hidden": false,
          "hint": "Warden hazard pay"
        }
      ]
    },
    {
      "name": "Clearance Work",
      "description": "Miners expanding Stonebridge Quarry broke into a sealed vault of pre-kingdom stonework. The foreman wants the chambers cleared and surveyed before the Guildhall claims salvage rights.",
      "status": "Available",
      "tier": "Tier 1",
      "region": "Stonebridge Quarry",
      "cooldown_days": 7,
      "is_discoverable": true,
      "is_retired": false,
      "prerequisite_name": null,
      "rewards": [
        {
          "gold": 60,
          "xp": 350,
          "item_name": null,
          "is_hidden": false,
          "hint": "Quarry foreman retainer"
        }
      ]
    },
    {
      "name": "Whispers in the Mire",
      "description": "Marsh scouts report eerie green lantern-lights drifting over a half-sunken temple east of the Ashwood. Recover any intact carvings and find out what is drawing locals toward the reeds.",
      "status": "Available",
      "tier": "Tier 1",
      "region": "Sunken Mire",
      "cooldown_days": 14,
      "is_discoverable": true,
      "is_retired": false,
